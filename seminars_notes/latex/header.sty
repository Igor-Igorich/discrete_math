% --- Язык и шрифты ---
\usepackage{cmap}                   % поиск в PDF
\usepackage{indentfirst}            % Отступ первого параграфа
\usepackage[T2A]{fontenc}           % кодировка
\usepackage[utf8]{inputenc}         % кодировка исходного текста
\usepackage[english,russian]{babel} % локализация и переносы

%% Кастомизация списокв
\usepackage{enumitem}

% --- Математика ---
\usepackage{amsmath, amsfonts, amssymb, amsthm, mathtools} %AMS
\usepackage{icomma} % "Умная" запятая: $0,2$ --- число, $0, 2$ --- перечисление
\usepackage{cancel} % Для зачеркивания сокращаемых слагаемых

%% Номера формул
\mathtoolsset{showonlyrefs=true} % Показывать номера только у тех формул, на которые есть \eqref{} в тексте.

% --- Графика и алгоритмы ---
\usepackage{xcolor}
\usepackage{float}          % [H] — "поставить ровно здесь"
\usepackage{pgfplots}       % графики функций
\pgfplotsset{compat=1.18}
\usepackage{tikz}           % векторная графика
\usetikzlibrary{arrows.meta,matrix}
\usepackage{wrapfig}        % обтекание текстом
\usepackage{graphicx}
\graphicspath{{img/}}
\usepackage{listings} % Для вставок кода

% --- Настройки страницы и ссылок ---
\usepackage[left=1.5cm, right=1.5cm, top=2cm, bottom=2cm, bindingoffset=0cm]{geometry}
\usepackage[unicode=true, colorlinks=true, linkcolor=blue, urlcolor=blue, citecolor=black]{hyperref}
\usepackage{nameref} % \nameref{sec:intro} печатает название секции вместо её номера.

\usepackage{titlesec}

% --- Горизонтальные и вертикальные отступы секций ---
\titlespacing*{\section}
  {0pt}                          % отступ слева
  {3.5ex plus 1ex minus .2ex}    % отступ сверху
  {2em}                          % отступ снизу

\titlespacing*{\subsection}
  {0pt}
  {4.5ex plus 1ex minus .2ex}
  {1.5ex plus .2ex}

% --- Подподраздел: сдвиг вправо и 1em вертикального отступа сверху ---
\titlespacing*{\subsubsection}
  {1 em}                          % отступ слева (сдвиг заголовка)
  {2 em}                          % отступ сверху
  {1ex plus .2ex}                % отступ снизу

% --- Оформление теорем и определений ---
\theoremstyle{plain} % Курсивный текст (это стиль по умолчанию, его можно не переопределять).
\newtheorem{theorem}{Теорема}[section]
\newtheorem{lemma}[theorem]{Лемма}
\newtheorem{proposition}[theorem]{Утверждение}
\newtheorem*{corollary}{Следствие}


\theoremstyle{definition} % Прямой текст
\newtheorem{definition}{Определение}[section]
\newtheorem{problem}{Задача}[section]
\newtheorem*{designation}{Обозначение}
\newtheorem*{properties}{Свойства}


\theoremstyle{remark}
\newtheorem{remark}{Замечание}[section]
\newtheorem*{example}{Пример}

\renewcommand{\qedsymbol}{$\blacksquare$}

% --- Пользовательские макросы (шорткаты) ---
% Позволяют писать \R вместо \mathbb{R}
\newcommand{\R}{\mathbb{R}}
\newcommand{\N}{\mathbb{N}}
\newcommand{\Z}{\mathbb{Z}}
\newcommand{\Q}{\mathbb{Q}}
\newcommand{\B}{\mathbb{B}}
\renewcommand{\C}{\mathbb{C}}
\newcommand{\E}{\mathbb{E}}       % Математическое ожидание
\newcommand{\eps}{\varepsilon}
\renewcommand{\phi}{\varphi}      % Классическое начертание фи
\newcommand{\symdiff}{\mathbin{\triangle}} % Симметрическая разность
\newcommand{\powerset}{\mathcal{P}} % Булеан (множество всех подмножеств)

\newcommand{\abs}[1]{\left| #1 \right|}
\newcommand{\norm}[1]{\left\| #1 \right\|}

\newcommand{\textdef}[1]{\underline{\textbf{\textit{#1}}}} % Кастомная функция для выделения опеределений
